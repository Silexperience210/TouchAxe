{
  "_comment": "Sunton ESP32-S3 4.3in 480x272 RGB panel with GT911 capacitive touch. This definition was missing from the repository, which meant `pio run` failed for anyone who cloned it. PlatformIO picks up board JSONs from the boards/ directory automatically.",
  "build": {
    "arduino": {
      "ldscript": "esp32s3_out.ld",
      "memory_type": "qio_qspi",
      "partitions": "default_8MB.csv"
    },
    "core": "esp32",
    "extra_flags": [
      "-DARDUINO_ESP32S3_DEV",
      "-DBOARD_HAS_PSRAM",
      "-DARDUINO_USB_MODE=0",
      "-DARDUINO_USB_CDC_ON_BOOT=0"
    ],
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "qio",
    "psram_type": "qspi",
    "hwids": [
      ["0x303A", "0x1001"],
      ["0x1A86", "0x7523"]
    ],
    "mcu": "esp32s3",
    "variant": "esp32s3"
  },
  "connectivity": ["wifi", "bluetooth"],
  "debug": {
    "default_tool": "esp-builtin",
    "onboard_tools": ["esp-builtin"],
    "openocd_target": "esp32s3.cfg"
  },
  "frameworks": ["arduino", "espidf"],
  "name": "Sunton ESP32-S3 4827S043C (480x272 IPS, GT911, 8MB Flash / 8MB PSRAM)",
  "upload": {
    "flash_size": "8MB",
    "maximum_ram_size": 327680,
    "maximum_size": 8388608,
    "require_upload_port": true,
    "speed": 921600
  },
  "url": "https://github.com/Silexperience210/TouchAxe/blob/main/HARDWARE_RESOURCES.md",
  "vendor": "Sunton"
}
